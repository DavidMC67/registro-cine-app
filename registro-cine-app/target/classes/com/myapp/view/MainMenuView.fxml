<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefHeight="500.0" prefWidth="800.0" styleClass="dashboard"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.myapp.controller.MainMenuController">

    <top>
        <VBox>
            <MenuBar>
                <Menu text="Archivo">
                    <MenuItem text="Salir" />
                </Menu>
                <Menu text="Ayuda">
                    <MenuItem text="Acerca de" />
                </Menu>
            </MenuBar>
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="header-bar">
                <padding>
                    <Insets top="10.0" bottom="10.0" left="16.0" right="16.0" />
                </padding>
                <ImageView fitHeight="34" preserveRatio="true">
                    <image>
                        <Image url="@images/header-logo.png" />
                    </image>
                </ImageView>
                <Label fx:id="lblUsuario" styleClass="usuario-label" />
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox spacing="8.0" styleClass="sidebar" prefWidth="180.0">
            <padding>
                <Insets top="20.0" bottom="20.0" left="12.0" right="12.0" />
            </padding>
            <Button styleClass="boton-nav" text="Inicio" onAction="#handleInicio" maxWidth="Infinity">
                <graphic><FontIcon iconLiteral="fas-home" /></graphic>
            </Button>
            <Button styleClass="boton-nav" text="Perfil" onAction="#handlePerfil" maxWidth="Infinity">
                <graphic><FontIcon iconLiteral="fas-user" /></graphic>
            </Button>
            <Button styleClass="boton-nav" text="Configuración" onAction="#handleConfiguracion" maxWidth="Infinity">
                <graphic><FontIcon iconLiteral="fas-cog" /></graphic>
            </Button>
            <Button styleClass="boton-nav boton-logout" text="Cerrar Sesión" onAction="#handleCerrarSesion" maxWidth="Infinity">
                <graphic><FontIcon iconLiteral="fas-sign-out-alt" /></graphic>
            </Button>
        </VBox>
    </left>

    <center>
        <TabPane fx:id="tabPaneTablas" styleClass="content-area" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Usuarios">
                    <content>
                        <HBox spacing="16.0">
                            <padding>
                                <Insets top="10.0" bottom="10.0" left="10.0" right="10.0" />
                            </padding>
                            <TableView fx:id="tablaUsuarios" HBox.hgrow="ALWAYS" />
                            <VBox alignment="TOP_CENTER" spacing="8.0" styleClass="form-box" prefWidth="150.0">
                                <padding>
                                    <Insets top="12.0" bottom="12.0" left="10.0" right="10.0" />
                                </padding>
                                <ImageView fitWidth="120" preserveRatio="true">
                                    <image>
                                        <Image url="@images/splash-logo.png" />
                                    </image>
                                </ImageView>
                            </VBox>
                        </HBox>
                    </content>
                </Tab>
                <Tab text="Roles">
                    <content>
                        <HBox spacing="16.0">
                            <padding>
                                <Insets top="10.0" bottom="10.0" left="10.0" right="10.0" />
                            </padding>
                            <TableView fx:id="tablaRoles" HBox.hgrow="ALWAYS" />
                            <VBox alignment="TOP_CENTER" spacing="8.0" styleClass="form-box" prefWidth="150.0">
                                <padding>
                                    <Insets top="12.0" bottom="12.0" left="10.0" right="10.0" />
                                </padding>
                                <ImageView fitWidth="120" preserveRatio="true">
                                    <image>
                                        <Image url="@images/splash-logo.png" />
                                    </image>
                                </ImageView>
                            </VBox>
                        </HBox>
                    </content>
                </Tab>
                <Tab text="Gestión de Películas">
                    <content>
                        <fx:include source="PeliculaView.fxml" />
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>

</BorderPane>
